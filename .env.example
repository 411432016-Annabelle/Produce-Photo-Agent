# Copy this file to .env and fill in your own values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot page → Reset Token). SECRET.
DISCORD_TOKEN=paste-your-bot-token-here

# ID of the one channel the agent listens to (right-click the channel → Copy Channel ID).
CHANNEL_ID=123456789012345678

# Claude model used by claude -p, e.g. sonnet or haiku.
CLAUDE_MODEL=sonnet

# Folder for photos, the Excel log and the backup file. Relative paths start from the project folder.
DATA_DIR=./data
